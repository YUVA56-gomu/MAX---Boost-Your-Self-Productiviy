{
  "name": "adaptive-productivity-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local-First Adaptive Productivity Desktop Application",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/run-backend.ps1",
    "dev:frontend": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "test:frontend": "pnpm --dir frontend exec vitest run",
    "test:backend": "backend\\.venv\\Scripts\\python.exe -m pytest backend/tests -v",
    "test:desktop": "powershell -ExecutionPolicy Bypass -File ./scripts/test-desktop-lifecycle.ps1",
    "test": "pnpm test:backend && pnpm test:frontend && pnpm test:desktop",
    "tauri": "tauri",
    "lint": "pnpm --dir frontend run lint"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}
